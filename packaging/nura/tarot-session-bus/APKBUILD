# Session-only D-Bus dependency; never replaces the distribution system bus.
pkgname=tarot-session-bus
pkgver=1.16.2
pkgrel=0
pkgdesc="D-Bus session daemon with Linux process credentials for Tarot"
url="https://www.freedesktop.org/wiki/Software/dbus/"
arch="aarch64"
license="AFL-2.1 OR GPL-2.0-or-later"
depends="dbus~$pkgver"
makedepends="expat-dev glib-dev libsm-dev libx11-dev linux-headers meson"
source="https://dbus.freedesktop.org/releases/dbus/dbus-$pkgver.tar.xz
	0001-linux-process-fd.patch
	cross-cc.sh
	"
builddir="$srcdir/dbus-$pkgver"

build() {
	if [ -n "${TAROT_SYSROOT:-}" ]; then
		# abuild-meson supplies the architecture; this overlay supplies the
		# verified SDK and clang driver used by the Tarot cross builder.
		export PKG_CONFIG_SYSROOT_DIR="$TAROT_SYSROOT"
		export PKG_CONFIG_LIBDIR="$TAROT_SYSROOT/usr/lib/pkgconfig:$TAROT_SYSROOT/usr/share/pkgconfig"
		cat > "$srcdir/tarot-sdk.cross" <<-EOF
		[binaries]
		c = '$srcdir/cross-cc.sh'
		strip = 'llvm-strip'
		readelf = 'llvm-readelf'
		objcopy = 'llvm-objcopy'
		[properties]
		sys_root = '$TAROT_SYSROOT'
		pkg_config_libdir = ['$TAROT_SYSROOT/usr/lib/pkgconfig', '$TAROT_SYSROOT/usr/share/pkgconfig']
		EOF
		set -- --cross-file="$srcdir/tarot-sdk.cross"
	else
		set --
	fi
	# Keep the OpenRC baseline's daemon features and native regression tests.
	# Static internal libdbus keeps the header fix inside
	# this executable; no private shared library shadows the platform library.
	abuild-meson "$@" \
		--default-library=static \
		-Dsystem_pid_file=/run/dbus/dbus.pid \
		-Dmodular_tests=enabled \
		-Dx11_autolaunch=enabled \
		-Dsystemd=disabled \
		-Ddoxygen_docs=disabled -Dducktype_docs=disabled \
		-Dqt_help=disabled -Dxml_docs=disabled \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	install -Dm755 output/bus/dbus-daemon "$pkgdir/usr/libexec/tarot-dbus-daemon"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
	local notice
	for notice in LICENSES/*.txt; do
		install -Dm644 "$notice" "$pkgdir/usr/share/licenses/$pkgname/$notice"
	done
}

