<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Tarot</vendor>
  <vendor_url>https://github.com/timschmidt/tarot</vendor_url>
  <action id="org.tarot.boot-destination">
    <description>Change what the phone shows at startup</description>
    <message>Authentication is required to change what the phone shows at startup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tarot-boot-destination</annotate>
  </action>
</policyconfig>
