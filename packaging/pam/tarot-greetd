#%PAM-1.0
# Used by greetd only while Tarot's boot destination selects direct boot.
# greetd 0.10.3 opens its initial session with an empty environment, so the
# session type is supplied here, before pam_elogind registers the session.
# Sessions whose greeter already provides a type keep it.
auth include base-auth
account include base-account
password include base-password
session required pam_env.so readenv=0 user_readenv=0 conffile=/usr/share/tarot/greetd-session.conf
session include base-session
